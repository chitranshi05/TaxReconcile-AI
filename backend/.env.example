# Tax Reconcile-AI — Backend Environment Template
# Copy this file to backend/.env and fill in your values.
# The .env file is gitignored and must NEVER be committed.

# JWT secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017

# MongoDB database name
DATABASE_NAME=tax_reconcile_ai

# App metadata
APP_NAME=Tax Reconcile-AI
APP_VERSION=1.0.0

# Maximum upload file size in bytes (default: 20 MB)
MAX_UPLOAD_BYTES=20971520

# Comma-separated CORS origins (frontend dev server URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
